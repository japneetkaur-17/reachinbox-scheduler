# ---------- Server ----------
PORT=4000
NODE_ENV=development
# Where the React app runs (used for CORS + post-login redirects)
FRONTEND_URL=http://localhost:5173
JWT_SECRET=change-me-to-a-long-random-string

# ---------- MySQL ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=scheduler
DB_PASSWORD=scheduler
DB_NAME=email_scheduler

# ---------- Redis ----------
REDIS_URL=redis://127.0.0.1:6379

# ---------- Elasticsearch ----------
ELASTICSEARCH_URL=http://127.0.0.1:9200
ELASTICSEARCH_INDEX=emails

# ---------- Queue / throughput ----------
# How many jobs one worker process handles in parallel
WORKER_CONCURRENCY=5
# Minimum gap between two sends from the SAME sender mailbox (Redis slot reservation, shared by all workers)
MIN_DELAY_BETWEEN_SENDS_MS=2000
# Hard cap per sender mailbox per clock hour (Redis counters, shared by all workers)
MAX_EMAILS_PER_HOUR_PER_SENDER=50
# Retries for transient SMTP failures
SEND_MAX_ATTEMPTS=3
# Run the worker inside the API process (handy for local dev). Set false and run `npm run dev:worker` separately for production.
RUN_WORKER_IN_API=true

# ---------- Ethereal senders ----------
# Comma separated user:pass pairs from https://ethereal.email/create
# Leave empty to auto-create 2 Ethereal accounts on first boot (saved to DB so they survive restarts)
SMTP_SENDERS=
ETHEREAL_AUTO_SENDERS=2

# ---------- Google OAuth ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Goes through the Vite proxy so the auth cookie is first-party for the frontend
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback

# ---------- Slack OAuth ----------
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Slack requires HTTPS: expose port 4000 with ngrok and put the https URL here
SLACK_REDIRECT_URI=https://your-subdomain.ngrok-free.app/api/slack/callback

# ---------- Bull Board (optional basic auth) ----------
BULL_BOARD_USER=
BULL_BOARD_PASSWORD=
